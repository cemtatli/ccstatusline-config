{
  "version": 3,
  "lines": [
    [
      {
        "id": "git-root-dir",
        "type": "git-root-dir",
        "metadata": {
          "hideNoGit": "true"
        },
        "color": "#e6e6e6"
      },
      {
        "id": "git-branch",
        "type": "git-branch",
        "character": "",
        "color": "#e6e6e6"
      },
      {
        "id": "git-changes",
        "type": "git-changes",
        "character": "",
        "color": "#e6e6e6"
      },
      {
        "id": "lines-diff",
        "type": "custom-command",
        "commandPath": "{{HOME}}/.config/ccstatusline/lines-diff.sh",
        "timeout": 1000,
        "color": "#e6e6e6",
        "preserveColors": true
      },
      {
        "id": "model-effort",
        "type": "custom-command",
        "commandPath": "{{HOME}}/.config/ccstatusline/model-effort.sh",
        "timeout": 1000,
        "color": "#e6e6e6"
      },
      {
        "id": "context-bar",
        "type": "custom-command",
        "commandPath": "{{HOME}}/.config/ccstatusline/context-bar.sh",
        "timeout": 1000,
        "color": "#e6e6e6",
        "preserveColors": true
      },
      {
        "id": "session-block",
        "type": "custom-command",
        "color": "#ff9e64",
        "commandPath": "{{HOME}}/.config/ccstatusline/session-block.sh",
        "timeout": 1000,
        "preserveColors": true
      },
      {
        "id": "weekly-usage",
        "type": "weekly-usage",
        "color": "#e6e6e6"
      }
    ]
  ],
  "flexMode": "full-until-compact",
  "compactThreshold": 60,
  "colorLevel": 3,
  "defaultPadding": " ",
  "inheritSeparatorColors": false,
  "globalBold": false,
  "gitCacheTtlSeconds": 5,
  "minimalistMode": false,
  "powerline": {
    "enabled": false,
    "separators": [
      ""
    ],
    "separatorInvertBackground": [
      false
    ],
    "startCaps": [
      ""
    ],
    "endCaps": [
      ""
    ],
    "theme": "gruvbox",
    "autoAlign": false,
    "continueThemeAcrossLines": true
  },
  "installation": {
    "method": "pinned",
    "installedVersion": "2.2.22"
  }
}